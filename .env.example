# Waitlist form endpoint. Any provider that accepts a plain HTML form POST
# works. Web3Forms (https://web3forms.com) is the free-tier default this kit
# is built around - create an account there to get an access key.
PUBLIC_WAITLIST_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_WEB3FORMS_KEY=

# Set to 1 to allow a production build with no PUBLIC_WAITLIST_ENDPOINT.
# Waitlist forms render as "Waitlist opens soon" instead of failing the build.
# LAUNCHFOLD_ALLOW_NO_WAITLIST=1
