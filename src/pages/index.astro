---
import Base from '../layouts/Base.astro';
import {
  getHero,
  getProblem,
  getDemo,
  getHowItWorks,
  getFounder,
  getPricing,
  getFaq,
  getCta,
} from '../lib/landing';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Demo from '../components/sections/Demo.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Founder from '../components/sections/Founder.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const hero = await getHero();
const problem = await getProblem();
const demo = await getDemo();
const howItWorks = await getHowItWorks();
const founder = await getFounder();
const pricing = await getPricing();
const faq = await getFaq();
const cta = await getCta();
---

<Base description={hero?.subheadline}>
  {hero && <Hero hero={hero} />}
  {problem && <Problem problem={problem} />}
  <Demo demo={demo} />
  {howItWorks && <HowItWorks howItWorks={howItWorks} />}
  <Founder founder={founder} />
  {faq && <Faq faq={faq} />}
  {cta && <FinalCta cta={cta} pricing={pricing} />}
</Base>

<script is:inline>
  (function () {
    var revealed = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
      revealed.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    revealed.forEach(function (el) {
      observer.observe(el);
    });

    var scrubbed = document.querySelectorAll('.scroll-scrub');
    var parallaxed = document.querySelectorAll('.parallax');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ((!scrubbed.length && !parallaxed.length) || reduceMotion) return;

    var PARALLAX_MAX = 18;
    var ticking = false;

    function updateScrub() {
      var vh = window.innerHeight;
      scrubbed.forEach(function (el) {
        var top = el.getBoundingClientRect().top;
        var progress = 1 - Math.min(Math.max(top / vh, 0), 1);
        var from = parseFloat(el.dataset.scaleFrom || '1.15');
        var to = parseFloat(el.dataset.scaleTo || '1');
        var scale = from + (to - from) * progress;
        el.style.transform = 'scale(' + scale.toFixed(3) + ')';
      });
      parallaxed.forEach(function (el) {
        var rect = el.getBoundingClientRect();
        var centerOffset = rect.top + rect.height / 2 - vh / 2;
        var drift = Math.max(Math.min(centerOffset * -0.06, PARALLAX_MAX), -PARALLAX_MAX);
        el.style.transform = 'translateY(' + drift.toFixed(1) + 'px)';
      });
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateScrub);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateScrub();
  })();
</script>
