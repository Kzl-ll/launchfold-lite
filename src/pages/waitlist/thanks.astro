---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { getCta } from '../../lib/landing';
import Button from '../../components/ui/Button.astro';

const cta = await getCta();

const shareText = encodeURIComponent(`I just joined the waitlist for ${site.name}.`);
const shareUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(site.url)}`;
---

<Base title="You're on the list" noindex>
  <section class="py-section">
    <div class="mx-auto max-w-xl px-6 text-center">
      <h1 class="heading text-3xl md:text-4xl">You're on the list</h1>
      {cta?.reassurance && <p class="mt-4 text-lg text-muted">{cta.reassurance}</p>}

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={shareUrl} variant="secondary">Share on X</Button>
        <Button href="/" variant="ghost">Back home</Button>
      </div>
    </div>
  </section>
</Base>
