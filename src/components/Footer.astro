---
import Container from './ui/Container.astro';
import { site } from '../site.config';
import { LAUNCHFOLD_URL } from '../lib/launchfold';

const year = new Date().getFullYear();

const socialLinks = [
  site.links.x ? { label: 'X', href: site.links.x } : null,
  site.links.github ? { label: 'GitHub', href: site.links.github } : null,
  site.links.email ? { label: 'Email', href: `mailto:${site.links.email}` } : null,
].filter((link): link is { label: string; href: string } => link !== null);
---

<footer class="border-t border-border">
  <Container class="flex flex-col gap-6 py-section text-sm text-muted">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="heading text-fg">{site.name}</p>
        <p>{site.tagline}</p>
      </div>
      <nav class="flex flex-wrap gap-4" aria-label="Footer">
        {
          socialLinks.map((link) => (
            <a href={link.href} class="hover:text-accent">
              {link.label}
            </a>
          ))
        }
        <a href="/privacy" class="hover:text-accent">Privacy</a>
        <a href="/terms" class="hover:text-accent">Terms</a>
      </nav>
    </div>
    <div class="flex flex-col gap-2 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <div class="flex flex-wrap gap-4">
        {site.demoNotice && <p>Demo content: {site.name} is a fictional product.</p>}
        {
          site.showAttribution && (
            <a href={LAUNCHFOLD_URL} class="hover:text-accent">
              Built with Launchfold
            </a>
          )
        }
      </div>
    </div>
  </Container>
</footer>
