---
interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  level?: 'h1' | 'h2';
  align?: 'left' | 'center';
}

const { eyebrow, heading, subheading, level = 'h2', align = 'left' } = Astro.props;
const Tag = level;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="label text-sm text-accent">{eyebrow}</p>}
  <Tag class="heading text-3xl md:text-4xl">{heading}</Tag>
  {subheading && <p class="mt-3 text-lg text-muted">{subheading}</p>}
</div>
