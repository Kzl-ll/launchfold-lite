---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  faq: CollectionEntry<'faq'>['data'];
}

const { faq } = Astro.props;
---

<section id="faq" class="py-section">
  <Container>
    <SectionHeading heading={faq.heading} />

    <div class="mt-10 divide-y divide-border border-t border-border">
      {
        faq.items.map((item) => (
          <details class="reveal group py-4">
            <summary class="heading flex cursor-pointer list-none items-center justify-between gap-4 text-lg text-fg [&::-webkit-details-marker]:hidden">
              {item.question}
              <span class="flex-none font-mono text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
